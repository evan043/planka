# BO360 Operations Command Console - Planka Environment Configuration
# Copy this file to .env and edit the values for your deployment

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# The base URL where Planka will be accessible
BASE_URL=http://localhost:3000

# A secure random string for session encryption
# IMPORTANT: Generate a secure random key for production!
# You can use: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-string

# =============================================================================
# ADMIN ACCOUNT (Optional - for initial setup)
# =============================================================================

# Default admin account created on first startup
# Comment out to manually create admin account
DEFAULT_ADMIN_EMAIL=admin@bo360.local
DEFAULT_ADMIN_PASSWORD=changeme123
DEFAULT_ADMIN_NAME=BO360 Admin
DEFAULT_ADMIN_USERNAME=admin

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Default language for the application
DEFAULT_LANGUAGE=en-US

# Logging level: error, warn, info, debug
LOG_LEVEL=info

# Set to true if behind a reverse proxy (Nginx, Cloudflare, etc.)
# TRUST_PROXY=true

# Maximum file upload size in bytes
# MAX_UPLOAD_FILE_SIZE=

# Token expiration in days
# TOKEN_EXPIRES_IN=365

# =============================================================================
# EMAIL NOTIFICATIONS (Optional)
# =============================================================================

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="BO360 Planka" <noreply@example.com>

# =============================================================================
# S3 STORAGE (Optional - for attachments)
# =============================================================================

# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_FORCE_PATH_STYLE=true

# =============================================================================
# OIDC / SSO (Optional)
# =============================================================================

# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_ADMIN_ROLES=admin
# OIDC_ENFORCED=false
