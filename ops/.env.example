# Planka Production Environment Variables
# Copy to /opt/planka/.env on the droplet

# Database
PLANKA_DB_PASSWORD=your-secure-db-password-here

# Application
PLANKA_SECRET_KEY=generate-with-openssl-rand-hex-64
PLANKA_ADMIN_EMAIL=admin@eroland.me
PLANKA_ADMIN_PASSWORD=your-admin-password-here

# OIDC/SSO Configuration (for BO360 integration)
# Uncomment when ready to enable SSO:
# OIDC_ISSUER=https://auth.eroland.me
# OIDC_CLIENT_ID=planka
# OIDC_CLIENT_SECRET=your-oidc-client-secret
